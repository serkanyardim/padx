<Window x:Class="Paddock.App.Views.DrawAreaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Pad"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="#26000000"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Cursor="Cross"
        MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
        MouseMove="Overlay_MouseMove"
        MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
        MouseRightButtonUp="Overlay_Cancel"
        KeyDown="Overlay_KeyDown">

    <Canvas x:Name="DrawCanvas" Background="Transparent">

        <!-- Rectangle being drawn -->
        <Border x:Name="SelectionRect"
                Visibility="Collapsed"
                BorderBrush="#990A84FF"
                BorderThickness="2"
                Background="#330A84FF"
                CornerRadius="8"
                IsHitTestVisible="False" />

        <!-- Instructions -->
        <Border x:Name="HintPanel"
                Background="#E01C1C1E"
                CornerRadius="10"
                IsHitTestVisible="False">
            <TextBlock Text="Drag to draw a new pad&#x2003;·&#x2003;Esc to cancel"
                       Foreground="#E5E5EA"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="13"
                       FontWeight="Medium"
                       Padding="18,12" />
        </Border>
    </Canvas>
</Window>

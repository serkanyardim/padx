<Window x:Class="Paddock.App.Views.DesktopLayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="padx desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <!-- Only the icons are drawn: every transparent pixel lets the mouse through
         to the real desktop (its menu, wallpaper, Ctrl + drag…). -->
    <ItemsControl x:Name="Items">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
            </Style>
        </ItemsControl.ItemContainerStyle>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Width="{Binding Width}" Height="{Binding Height}"
                        CornerRadius="4"
                        Cursor="Hand"
                        ToolTip="{Binding Icon.ToolTipText}"
                        MouseLeftButtonDown="Icon_MouseLeftButtonDown"
                        MouseLeftButtonUp="Icon_MouseLeftButtonUp"
                        MouseMove="Icon_MouseMove"
                        MouseRightButtonUp="Icon_RightClick">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Nearly clear rather than clear, so the whole cell catches the mouse -->
                            <Setter Property="Background" Value="#01FFFFFF" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30FFFFFF" />
                                    <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Icon.IsSpotlit}" Value="True">
                                    <Setter Property="Background" Value="#5500D1FF" />
                                    <Setter Property="BorderBrush" Value="{StaticResource D.Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <Image Source="{Binding Icon.IconImage}"
                               Width="{Binding IconSize}" Height="{Binding IconSize}"
                               HorizontalAlignment="Center" Margin="0,7,0,4"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Icon.DisplayName}"
                                   Foreground="White"
                                   FontFamily="Segoe UI Variable, Segoe UI" FontSize="11.5"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   LineHeight="15" MaxHeight="30" Margin="2,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="1" BlurRadius="3" Opacity="0.9" Direction="315" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>

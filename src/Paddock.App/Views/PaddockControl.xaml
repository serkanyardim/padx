<UserControl x:Class="Paddock.App.Views.PaddockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="Paddock_Drop"
             DragOver="Paddock_DragOver"
             DragEnter="Paddock_DragEnter"
             DragLeave="Paddock_DragLeave"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Two short diagonal strokes in the bottom-right corner; inset follows the corner radius -->
        <Style x:Key="ResizeGrip" TargetType="Path">
            <Setter Property="Data" Value="M 9,1 L 1,9 M 9,5 L 5,9" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stroke" Value="{Binding IconTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.1" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="{Binding GripMargin}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
        </Style>

        <!-- Fade-in animation for hover chrome -->
        <Storyboard x:Key="ShowChrome">
            <DoubleAnimation Storyboard.TargetName="HoverChrome"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15" />
        </Storyboard>
        <Storyboard x:Key="HideChrome">
            <DoubleAnimation Storyboard.TargetName="HoverChrome"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource ShowChrome}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource HideChrome}" />
        </EventTrigger>
    </UserControl.Triggers>

    <!-- Context menu for paddock management -->
    <UserControl.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Header="Rename" Click="ContextMenu_Rename" />
            <!-- Filled in code-behind from PadPalette -->
            <MenuItem x:Name="ColorMenu" Header="Color" />
            <MenuItem Header="Fill from Desktop" Visibility="{Binding NotDesktopVisibility}">
                <MenuItem Header="All items" Tag="All" Click="ContextMenu_FillFromDesktop" />
                <Separator />
                <MenuItem Header="Shortcuts" Tag="Shortcuts" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Folders" Tag="Folders" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Documents" Tag="Documents" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Images" Tag="Images" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Media" Tag="Media" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Archives" Tag="Archives" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Everything else" Tag="Other" Click="ContextMenu_FillFromDesktop" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Title Visibility">
                <MenuItem Header="Always Visible" IsCheckable="True"
                          IsChecked="{Binding IsTitleAlwaysVisible, Mode=OneWay}"
                          Click="TitleVisibility_Always" />
                <MenuItem Header="Show on Hover" IsCheckable="True"
                          IsChecked="{Binding IsTitleHoverVisible, Mode=OneWay}"
                          Click="TitleVisibility_Hover" />
                <MenuItem Header="Hidden" IsCheckable="True"
                          IsChecked="{Binding IsTitleHidden, Mode=OneWay}"
                          Click="TitleVisibility_Hidden" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Sort By">
                <MenuItem Header="Name" Click="Sort_Name" />
                <MenuItem Header="Date Modified" Click="Sort_Date" />
                <MenuItem Header="File Type" Click="Sort_Type" />
                <MenuItem Header="File Size" Click="Sort_Size" />
                <Separator />
                <MenuItem Header="Ascending" IsCheckable="True"
                          IsChecked="{Binding SortAscending}"
                          Click="Sort_ToggleDirection" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Roll Up / Expand" Click="ContextMenu_ToggleRollUp" />
            <MenuItem Header="Lock Position" IsCheckable="True"
                      IsChecked="{Binding IsLocked}" />
            <MenuItem Header="Exclude from Quick Hide" IsCheckable="True"
                      IsChecked="{Binding ExcludeFromQuickHide}" />
            <Separator />
            <MenuItem Header="Hide Pad" Click="ContextMenu_Hide" />
            <MenuItem Header="Delete Pad" Click="ContextMenu_Remove" Visibility="{Binding NotDesktopVisibility}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border CornerRadius="{Binding CornerRadius}"
            Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="{Binding BorderThickness}"
            SnapsToDevicePixels="True">

        <Grid>
            <!-- Glass reflection, under everything else -->
            <Border Background="{Binding SheenBrush}"
                    Visibility="{Binding SheenVisibility}"
                    CornerRadius="{Binding InnerCornerRadius}"
                    IsHitTestVisible="False" />

            <!-- Icon grid (hidden when rolled up) -->
            <ScrollViewer Margin="6,36,4,6"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          Visibility="{Binding ContentVisibility}">
                <ItemsControl x:Name="IconItems" ItemsSource="{Binding Icons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding DataContext.IconCellWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Height="{Binding DataContext.IconCellHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Margin="2"
                                    CornerRadius="3"
                                    MouseLeftButtonDown="Icon_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Icon_MouseLeftButtonUp"
                                    MouseRightButtonUp="Icon_RightClick"
                                    MouseMove="Icon_MouseMove"
                                    Cursor="Hand"
                                    ToolTip="{Binding ToolTipText}">
                                <!-- Background lives in the style so the hover
                                     trigger is not overridden by a local value. -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PaddockIconHover}" />
                                            </Trigger>
                                            <!-- Found with the desktop search's "Find place" -->
                                            <DataTrigger Binding="{Binding IsSpotlit}" Value="True">
                                                <Setter Property="Background" Value="#5500D1FF" />
                                                <Setter Property="BorderBrush" Value="{StaticResource D.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <Image Source="{Binding IconImage}"
                                           Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           HorizontalAlignment="Center"
                                           Margin="0,7,0,4"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <TextBlock Text="{Binding DisplayName}"
                                               Visibility="{Binding DataContext.IconLabelVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Foreground="{Binding DataContext.IconTextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Effect="{Binding DataContext.IconLabelEffect, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontFamily="Segoe UI Variable, Segoe UI"
                                               FontSize="10.5"
                                               FontWeight="Regular"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               LineHeight="14"
                                               MaxHeight="28" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty-state hint, so a new paddock explains itself -->
            <TextBlock Text="Drag desktop icons here&#x0a;or right-click to fill from the desktop"
                       Visibility="{Binding EmptyHintVisibility}"
                       Foreground="{Binding IconTextBrush}"
                       FontFamily="{StaticResource D.Mono}"
                       FontSize="10.5"
                       Opacity="0.55"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="16,32,16,16"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- Title area — handles drag-to-move and roll-up -->
            <Border x:Name="TitleArea"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="{Binding TitleBarBrush}"
                    CornerRadius="{Binding TitleBarCornerRadius}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                    Cursor="SizeAll">

                <Grid>
                    <!-- Title text (visibility controlled by mode) -->
                    <TextBlock x:Name="TitleText"
                               Text="{Binding TitleDisplay}"
                               Foreground="{Binding TitleTextBrush}"
                               FontFamily="{Binding TitleFontFamily}"
                               FontSize="{Binding TitleFontSize}"
                               FontWeight="Medium"
                               Margin="{Binding TitleMargin}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="{Binding TitleHorizontalAlignment}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Visible" />

                    <!-- Inline rename textbox (shown during rename) -->
                    <TextBox x:Name="RenameBox"
                             Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource D.Field}"
                             Margin="8,4,36,4"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             KeyDown="RenameBox_KeyDown"
                             LostFocus="RenameBox_LostFocus" />
                </Grid>
            </Border>

            <!-- Hover-only chrome (close button, resize grip dots) -->
            <Grid x:Name="HoverChrome" Opacity="0">
                <Border Width="18" Height="18"
                        CornerRadius="2"
                        Background="{DynamicResource PaddockCloseBackground}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,8,0"
                        Cursor="Hand"
                        ToolTip="Hide pad (tray menu or Ctrl+Alt+H brings it back) · an empty pad is removed"
                        MouseLeftButtonDown="CloseButton_Click">
                    <TextBlock Text="&#xD7;"
                               FontSize="14"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               Foreground="{DynamicResource PaddockCloseText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0" />
                </Border>

                <!-- Resize grip, hover mode -->
                <Path Style="{StaticResource ResizeGrip}" Visibility="{Binding HoverGripVisibility}" />
            </Grid>

            <!-- Resize grip, always-visible mode -->
            <Path Style="{StaticResource ResizeGrip}" Visibility="{Binding AlwaysGripVisibility}" />

            <!-- Drop feedback: outlines the paddock while a drag is over it -->
            <Border x:Name="DropHighlight"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    CornerRadius="{Binding CornerRadius}"
                    BorderBrush="{DynamicResource PaddockDropHighlight}"
                    BorderThickness="2" />

            <!-- Resize thumb (invisible, always hit-testable) -->
            <Thumb HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="18" Height="18"
                   Cursor="SizeNWSE"
                   Opacity="0"
                   Visibility="{Binding ContentVisibility}"
                   DragDelta="ResizeGrip_DragDelta"
                   DragCompleted="ResizeGrip_DragCompleted" />
        </Grid>
    </Border>
</UserControl>

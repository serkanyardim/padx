<Window x:Class="Paddock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Paddock.App.Helpers"
        xmlns:controls="clr-namespace:Paddock.App.Views.Controls"
        Title="padx Settings"
        Width="600" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource D.Bg}"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <helpers:EqualsConverter x:Key="Eq" />

        <!-- Fake wallpaper for the preview: colourful enough that blur and tint read clearly -->
        <DrawingBrush x:Key="PreviewBackdrop" Stretch="None" AlignmentX="Left" AlignmentY="Top">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M0,0 H552 V166 H0 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D3B5E" Offset="0" />
                                <GradientStop Color="#3A2456" Offset="0.55" />
                                <GradientStop Color="#0F4B4B" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF4D8D">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="190,52" RadiusX="44" RadiusY="44" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFC940">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="330,128" RadiusX="58" RadiusY="58" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#4DFFB8">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="392,34" RadiusX="30" RadiusY="30" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#3D8BFD">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="60,96,90,90" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#7FE7FF">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="470,130" RadiusX="24" RadiusY="24" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Key cap used in the mouse reference list -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource D.LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource D.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource D.TextDim}" />
        </Style>
        <Style TargetType="controls:HotkeyBox" BasedOn="{StaticResource D.Field}">
            <Setter Property="Width" Value="160" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource D.LineStrong}" BorderThickness="1">
        <DockPanel>

            <!-- ===== Title bar ===== -->
            <Grid DockPanel.Dock="Top" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Rectangle Width="8" Height="8" Fill="{StaticResource D.Accent}" Margin="0,0,10,0" />
                    <TextBlock Text="PADX" FontFamily="{StaticResource D.Mono}" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource D.Text}" />
                    <TextBlock Text="  // SETTINGS" FontFamily="{StaticResource D.Mono}" FontSize="12"
                               Foreground="{StaticResource D.TextDim}" />
                </StackPanel>

                <TextBlock Text="{Binding Version, StringFormat=v{0}}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,56,0"
                           FontFamily="{StaticResource D.Mono}" FontSize="10"
                           Foreground="{StaticResource D.TextFaint}" />

                <Button Style="{StaticResource D.ChromeButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,6,6,0" ToolTip="Close (Esc)"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.3"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <!-- ===== Status line ===== -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource D.Line}"
                    BorderThickness="0,1,0,0" Padding="22,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource D.Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="changes apply instantly" Style="{StaticResource D.Hint}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="esc to close" Style="{StaticResource D.Hint}" Margin="0"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <TabControl Style="{StaticResource D.Tabs}">

                <!-- ================= GENERAL ================= -->
                <TabItem Header="01  GENERAL">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,22,20">
                        <StackPanel>
                            <TextBlock Text="// STARTUP" Style="{StaticResource D.Section}" />

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                              VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}" />
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="launch padx when you sign in" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ScreenDefault}" Style="{StaticResource D.Value}" Width="Auto"
                                                   MaxWidth="200" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource D.Button}" Content="CONFIGS" Click="ManageConfigs_Click" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Layout per screen" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="each main-screen resolution can have a ★ default config; it loads at startup and when the screen changes" Style="{StaticResource D.Hint}" TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="// BEHAVIOR" Style="{StaticResource D.Section}" />

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                              VerticalAlignment="Center" IsChecked="{Binding CtrlDragCreatesPad}" />
                                    <StackPanel>
                                        <TextBlock Text="Ctrl + drag draws a pad" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="on empty desktop; on an icon, ctrl+drag still copies" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                              VerticalAlignment="Center" IsChecked="{Binding SnapEnabled}" />
                                    <StackPanel>
                                        <TextBlock Text="Snap to edges" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="pads snap to screen edges and to each other" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Slider Style="{StaticResource D.Slider}" Minimum="0" Maximum="40"
                                                Value="{Binding IntelligentSpacing}" />
                                        <TextBlock Style="{StaticResource D.Value}" Text="{Binding IntelligentSpacing, StringFormat={}{0:0}px}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Spacing" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="gap kept between pads and edges" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Style="{StaticResource D.Segment}" Content="CLICK"
                                                     IsChecked="{Binding RollUpExpandMode, Converter={StaticResource Eq}, ConverterParameter=click}" />
                                        <RadioButton Style="{StaticResource D.Segment}" Content="HOVER"
                                                     IsChecked="{Binding RollUpExpandMode, Converter={StaticResource Eq}, ConverterParameter=hover}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Rolled-up pads open on" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="double-click a title bar to roll a pad up" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="// DATA" Style="{StaticResource D.Section}" />

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource D.Button}"
                                            VerticalAlignment="Center" Content="RESTORE" Click="RestoreAll_Click" />
                                    <StackPanel>
                                        <TextBlock Text="Restore all icons to desktop" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="all icons back on the desktop sorted by type; empty pads are removed" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource D.Button}"
                                            VerticalAlignment="Center" Content="OPEN" Click="OpenFolder_Click" />
                                    <StackPanel>
                                        <TextBlock Text="Settings &amp; log folder" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="%AppData%\Paddock" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ================= SHORTCUTS ================= -->
                <TabItem Header="02  SHORTCUTS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,22,20">
                        <StackPanel>
                            <TextBlock Text="// GLOBAL KEYS" Style="{StaticResource D.Section}" />
                            <TextBlock Style="{StaticResource D.Hint}" Margin="0,0,0,6"
                                       Text="work from any app. click a field and press a combination — backspace clears it." />

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <controls:HotkeyBox DockPanel.Dock="Right" Hotkey="{Binding ToggleHotkey}" />
                                    <TextBlock Text="Show / hide pads" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <controls:HotkeyBox DockPanel.Dock="Right" Hotkey="{Binding NewPadHotkey}" />
                                    <TextBlock Text="New pad" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <controls:HotkeyBox DockPanel.Dock="Right" Hotkey="{Binding RollUpAllHotkey}" />
                                    <TextBlock Text="Roll up / expand all pads" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <controls:HotkeyBox DockPanel.Dock="Right" Hotkey="{Binding ShowHiddenHotkey}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Show hidden pads" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="brings back pads put away with their ×" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <controls:HotkeyBox DockPanel.Dock="Right" Hotkey="{Binding SettingsHotkey}" />
                                    <TextBlock Text="Open settings" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <TextBlock Text="{Binding HotkeyStatus}" Foreground="{StaticResource D.Danger}"
                                       FontFamily="{StaticResource D.Mono}" FontSize="10" Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="// MOUSE" Style="{StaticResource D.Section}" />

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                        <TextBlock Text="CTRL + DRAG DESKTOP" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <TextBlock Text="Draw a new pad" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                        <TextBlock Text="DOUBLE-CLICK TITLE" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <TextBlock Text="Roll up / expand a pad" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                        <TextBlock Text="DRAG TITLE" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <TextBlock Text="Move a pad" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                        <TextBlock Text="DRAG BOTTOM-RIGHT" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <TextBlock Text="Resize a pad" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                        <TextBlock Text="RIGHT-CLICK PAD" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <TextBlock Text="Pad menu: color, sort, rename, delete" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                        <TextBlock Text="× ON PAD" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <TextBlock Text="Hide a pad (contents stay in it)" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                        <TextBlock Text="DRAG ICON OUT" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <TextBlock Text="Put an icon back on the desktop" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                        <TextBlock Text="DOUBLE-CLICK TRAY" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <TextBlock Text="Show / hide pads" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ================= APPEARANCE ================= -->
                <TabItem Header="03  APPEARANCE">
                    <DockPanel>

                        <!-- Live preview stays put while the options scroll -->
                        <Border DockPanel.Dock="Top" Height="168" Margin="22,14,22,4"
                                BorderBrush="{StaticResource D.Line}" BorderThickness="1">
                            <Border.Background>
                                <StaticResource ResourceKey="PreviewBackdrop" />
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="PREVIEW" Margin="8,6" FontFamily="{StaticResource D.Mono}"
                                           FontSize="9" Foreground="#80FFFFFF" />

                                <Border Width="280" Height="136" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        BorderBrush="{Binding PreviewBorderBrush}"
                                        BorderThickness="{Binding PreviewBorderThickness}"
                                        CornerRadius="{Binding PreviewCornerRadius}">
                                    <Grid ClipToBounds="True">
                                        <!-- Stand-in for the desktop blur: the same backdrop, blurred -->
                                        <Rectangle Width="552" Height="166" Margin="-137,-16,0,0"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Fill="{StaticResource PreviewBackdrop}"
                                                   Visibility="{Binding PreviewBlurVisibility}">
                                            <Rectangle.Effect>
                                                <BlurEffect Radius="{Binding PreviewBlurRadius}" KernelType="Gaussian" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <Border Background="{Binding PreviewBackground}" />
                                        <Border Background="{Binding PreviewSheen}" Visibility="{Binding PreviewSheenVisibility}" />
                                        <Border Height="32" VerticalAlignment="Top"
                                                Background="{Binding PreviewTitleBarBrush}"
                                                CornerRadius="{Binding PreviewTitleBarCornerRadius}">
                                            <TextBlock Text="{Binding PreviewTitle}" Margin="12,0"
                                                       VerticalAlignment="Center" FontWeight="Medium"
                                                       Foreground="{Binding PreviewTitleBrush}"
                                                       FontFamily="{Binding PreviewTitleFont}"
                                                       FontSize="{Binding TitleFontSize}"
                                                       HorizontalAlignment="{Binding PreviewTitleAlignment}" />
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="8,38,8,4">
                                            <StackPanel Width="{Binding PreviewCellWidth}">
                                                <Border Width="{Binding PreviewIconSize}" Height="{Binding PreviewIconSize}"
                                                        CornerRadius="4" Background="#3D8BFD" Margin="0,4,0,4" />
                                                <TextBlock Text="Docs" TextAlignment="Center" FontSize="10.5"
                                                           Foreground="{Binding PreviewLabelBrush}" Effect="{Binding PreviewLabelEffect}"
                                                           Visibility="{Binding PreviewLabelVisibility}" />
                                            </StackPanel>
                                            <StackPanel Width="{Binding PreviewCellWidth}">
                                                <Border Width="{Binding PreviewIconSize}" Height="{Binding PreviewIconSize}"
                                                        CornerRadius="4" Background="#FFC940" Margin="0,4,0,4" />
                                                <TextBlock Text="Tools" TextAlignment="Center" FontSize="10.5"
                                                           Foreground="{Binding PreviewLabelBrush}" Effect="{Binding PreviewLabelEffect}"
                                                           Visibility="{Binding PreviewLabelVisibility}" />
                                            </StackPanel>
                                            <StackPanel Width="{Binding PreviewCellWidth}">
                                                <Border Width="{Binding PreviewIconSize}" Height="{Binding PreviewIconSize}"
                                                        CornerRadius="4" Background="#4DFFB8" Margin="0,4,0,4" />
                                                <TextBlock Text="Notes" TextAlignment="Center" FontSize="10.5"
                                                           Foreground="{Binding PreviewLabelBrush}" Effect="{Binding PreviewLabelEffect}"
                                                           Visibility="{Binding PreviewLabelVisibility}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Path Data="M 9,1 L 1,9 M 9,5 L 5,9" Width="10" Height="10"
                                              Stroke="{Binding PreviewLabelBrush}" StrokeThickness="1.1"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45"
                                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Margin="{Binding PreviewGripMargin}"
                                              Visibility="{Binding PreviewGripVisibility}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,22,20">
                            <StackPanel>

                                <TextBlock Text="// PAD" Style="{StaticResource D.Section}" />

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource D.Segment}" Content="CUSTOM"
                                                         IsChecked="{Binding PadStyle, Converter={StaticResource Eq}, ConverterParameter=Custom}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="ONE COLOR"
                                                         IsChecked="{Binding PadStyle, Converter={StaticResource Eq}, ConverterParameter=Color}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="GLASS"
                                                         IsChecked="{Binding PadStyle, Converter={StaticResource Eq}, ConverterParameter=Glass}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="All pads" Style="{StaticResource D.Label}" />
                                            <TextBlock Text="custom keeps each pad's own color" Style="{StaticResource D.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <controls:ColorField DockPanel.Dock="Right" VerticalAlignment="Center"
                                                             AllowMaterials="True" Color="{Binding PadColor}" />
                                        <StackPanel>
                                            <TextBlock Text="Default color" Style="{StaticResource D.Label}" />
                                            <TextBlock Text="right-click a pad → color to give it its own" Style="{StaticResource D.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Slider Style="{StaticResource D.Slider}" Minimum="0" Maximum="1"
                                                    Value="{Binding PadOpacity}" />
                                            <TextBlock Style="{StaticResource D.Value}" Text="{Binding PadOpacity, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Opacity" Style="{StaticResource D.Label}" />
                                            <TextBlock Text="icons always stay fully visible" Style="{StaticResource D.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Slider Style="{StaticResource D.Slider}" Minimum="0" Maximum="16"
                                                    Value="{Binding CornerRadius}" />
                                            <TextBlock Style="{StaticResource D.Value}" Text="{Binding CornerRadius, StringFormat={}{0:0}px}" />
                                        </StackPanel>
                                        <TextBlock Text="Corner radius" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource D.Segment}" Content="OFF"
                                                         IsChecked="{Binding ResizeGrip, Converter={StaticResource Eq}, ConverterParameter=Off}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="HOVER"
                                                         IsChecked="{Binding ResizeGrip, Converter={StaticResource Eq}, ConverterParameter=Hover}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="ALWAYS"
                                                         IsChecked="{Binding ResizeGrip, Converter={StaticResource Eq}, ConverterParameter=Always}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Resize grip" Style="{StaticResource D.Label}" />
                                            <TextBlock Text="two fine strokes in the corner; follows the radius" Style="{StaticResource D.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="// GLASS" Style="{StaticResource D.Section}" />
                                <TextBlock Style="{StaticResource D.Hint}" Margin="0,0,0,4"
                                           Text="for glass and frost pads — switch every pad with all pads ▸ glass above, or per pad from its menu" />

                                <StackPanel Opacity="{Binding GlassOptionsOpacity}">
                                    <Border Style="{StaticResource D.Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton Style="{StaticResource D.Segment}" Content="OFF"
                                                             IsChecked="{Binding GlassBlur, Converter={StaticResource Eq}, ConverterParameter=Off}" />
                                                <RadioButton Style="{StaticResource D.Segment}" Content="LIGHT"
                                                             IsChecked="{Binding GlassBlur, Converter={StaticResource Eq}, ConverterParameter=Light}" />
                                                <RadioButton Style="{StaticResource D.Segment}" Content="STRONG"
                                                             IsChecked="{Binding GlassBlur, Converter={StaticResource Eq}, ConverterParameter=Strong}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Blur" Style="{StaticResource D.Label}" />
                                                <TextBlock Text="strong = acrylic, with a frosted grain" Style="{StaticResource D.Hint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Style="{StaticResource D.Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Slider Style="{StaticResource D.Slider}" Minimum="0" Maximum="1"
                                                        Value="{Binding GlassTint}" />
                                                <TextBlock Style="{StaticResource D.Value}" Text="{Binding GlassTint, StringFormat={}{0:P0}}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Tint" Style="{StaticResource D.Label}" />
                                                <TextBlock Text="smoke for glass, milk for frost" Style="{StaticResource D.Hint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Style="{StaticResource D.Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Slider Style="{StaticResource D.Slider}" Minimum="0" Maximum="1"
                                                        Value="{Binding GlassShine}" />
                                                <TextBlock Style="{StaticResource D.Value}" Text="{Binding GlassShine, StringFormat={}{0:P0}}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Shine" Style="{StaticResource D.Label}" />
                                                <TextBlock Text="reflection and lit edge" Style="{StaticResource D.Hint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="// EDGE" Style="{StaticResource D.Section}" />

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <controls:ColorField DockPanel.Dock="Right" VerticalAlignment="Center"
                                                             Color="{Binding BorderColor}" />
                                        <TextBlock Text="Edge color" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Slider Style="{StaticResource D.Slider}" Minimum="0" Maximum="3"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding BorderThickness}" />
                                            <TextBlock Style="{StaticResource D.Value}" Text="{Binding BorderThickness, StringFormat={}{0:0}px}" />
                                        </StackPanel>
                                        <TextBlock Text="Edge thickness" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="// TITLE BAR" Style="{StaticResource D.Section}" />

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <controls:ColorField DockPanel.Dock="Right" VerticalAlignment="Center"
                                                             Color="{Binding TitleBarColor}" />
                                        <TextBlock Text="Bar color" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Slider Style="{StaticResource D.Slider}" Minimum="0" Maximum="1"
                                                    Value="{Binding TitleBarOpacity}" />
                                            <TextBlock Style="{StaticResource D.Value}" Text="{Binding TitleBarOpacity, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Bar opacity" Style="{StaticResource D.Label}" />
                                            <TextBlock Text="0% hides the bar, title text stays" Style="{StaticResource D.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <controls:ColorField DockPanel.Dock="Right" VerticalAlignment="Center"
                                                             Color="{Binding TitleTextColor}" />
                                        <TextBlock Text="Title color" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Slider Style="{StaticResource D.Slider}" Minimum="8" Maximum="20"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding TitleFontSize}" />
                                            <TextBlock Style="{StaticResource D.Value}" Text="{Binding TitleFontSize, StringFormat={}{0:0}pt}" />
                                        </StackPanel>
                                        <TextBlock Text="Title size" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource D.Segment}" Content="LEFT"
                                                         IsChecked="{Binding TitleAlignment, Converter={StaticResource Eq}, ConverterParameter=Left}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="CENTER"
                                                         IsChecked="{Binding TitleAlignment, Converter={StaticResource Eq}, ConverterParameter=Center}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="RIGHT"
                                                         IsChecked="{Binding TitleAlignment, Converter={StaticResource Eq}, ConverterParameter=Right}" />
                                        </StackPanel>
                                        <TextBlock Text="Title alignment" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource D.Segment}" Content="MONO"
                                                         IsChecked="{Binding TitleFont, Converter={StaticResource Eq}, ConverterParameter='Cascadia Mono'}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="DIN"
                                                         IsChecked="{Binding TitleFont, Converter={StaticResource Eq}, ConverterParameter=Bahnschrift}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="SANS"
                                                         IsChecked="{Binding TitleFont, Converter={StaticResource Eq}, ConverterParameter='Segoe UI Variable'}" />
                                        </StackPanel>
                                        <TextBlock Text="Title font" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                                  VerticalAlignment="Center" IsChecked="{Binding TitleUppercase}" />
                                        <TextBlock Text="Uppercase titles" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="// ICONS" Style="{StaticResource D.Section}" />

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource D.Segment}" Content="S"
                                                         IsChecked="{Binding IconSize, Converter={StaticResource Eq}, ConverterParameter=32}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="M"
                                                         IsChecked="{Binding IconSize, Converter={StaticResource Eq}, ConverterParameter=40}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="L"
                                                         IsChecked="{Binding IconSize, Converter={StaticResource Eq}, ConverterParameter=48}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="XL"
                                                         IsChecked="{Binding IconSize, Converter={StaticResource Eq}, ConverterParameter=56}" />
                                        </StackPanel>
                                        <TextBlock Text="Icon size" Style="{StaticResource D.Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                                  VerticalAlignment="Center" IsChecked="{Binding ShowIconLabels}" />
                                        <StackPanel>
                                            <TextBlock Text="Show icon labels" Style="{StaticResource D.Label}" />
                                            <TextBlock Text="label color adapts to the pad color" Style="{StaticResource D.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource D.Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Style="{StaticResource D.Segment}" Content="OFF"
                                                         IsChecked="{Binding LabelShadow, Converter={StaticResource Eq}, ConverterParameter=Off}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="AUTO"
                                                         IsChecked="{Binding LabelShadow, Converter={StaticResource Eq}, ConverterParameter=Auto}" />
                                            <RadioButton Style="{StaticResource D.Segment}" Content="ON"
                                                         IsChecked="{Binding LabelShadow, Converter={StaticResource Eq}, ConverterParameter=On}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Label shadow" Style="{StaticResource D.Label}" />
                                            <TextBlock Text="like the desktop; auto = only under light labels" Style="{StaticResource D.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Button Style="{StaticResource D.Button}" Content="RESET APPEARANCE"
                                        HorizontalAlignment="Left" Margin="0,18,0,0" Click="ResetAppearance_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <!-- ================= AUTO MODE ================= -->
                <TabItem Header="04  AUTO MODE">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,22,20">
                        <StackPanel>
                            <TextBlock Text="// AUTO ORGANIZE" Style="{StaticResource D.Section}" />
                            <TextBlock Style="{StaticResource D.Hint}" Margin="0,0,0,10"
                                       Text="sorts the desktop and every unlocked pad into category pads: folders, documents, media, browsers, dev tools, design &amp; cad... shortcuts are judged by the program they launch. locked pads are never touched. a bar in the corner lets you accept or revert." />

                            <Button Style="{StaticResource D.Button}" Content="RUN AUTO ORGANIZE" HorizontalAlignment="Left"
                                    Foreground="{StaticResource D.Accent}" Margin="0,0,0,6" Click="RunAutoOrganize_Click" />

                            <TextBlock Text="// LAYOUT" Style="{StaticResource D.Section}" />

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Slider Style="{StaticResource D.Slider}" Minimum="2" Maximum="12"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxIconsPerRow}" />
                                        <TextBlock Style="{StaticResource D.Value}" Text="{Binding MaxIconsPerRow}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Icons per row" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="most icons side by side; pads grow downwards after that" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Slider Style="{StaticResource D.Slider}" Minimum="1" Maximum="5"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MinItemsPerPad}" />
                                        <TextBlock Style="{StaticResource D.Value}" Text="{Binding MinItemsPerPad}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Smallest pad" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="categories with fewer icons go into &quot;other&quot;" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Style="{StaticResource D.Segment}" Content="LEFT"
                                                     IsChecked="{Binding AutoStartCorner, Converter={StaticResource Eq}, ConverterParameter=TopLeft}" />
                                        <RadioButton Style="{StaticResource D.Segment}" Content="RIGHT"
                                                     IsChecked="{Binding AutoStartCorner, Converter={StaticResource Eq}, ConverterParameter=TopRight}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Start from" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="pads fill down, then across, from this side" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="// PADS" Style="{StaticResource D.Section}" />

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Style="{StaticResource D.Segment}" Content="DEFAULT"
                                                     IsChecked="{Binding AutoColorMode, Converter={StaticResource Eq}, ConverterParameter=Default}" />
                                        <RadioButton Style="{StaticResource D.Segment}" Content="CATEGORY"
                                                     IsChecked="{Binding AutoColorMode, Converter={StaticResource Eq}, ConverterParameter=ByCategory}" />
                                        <RadioButton Style="{StaticResource D.Segment}" Content="RANDOM"
                                                     IsChecked="{Binding AutoColorMode, Converter={StaticResource Eq}, ConverterParameter=Random}" />
                                        <RadioButton Style="{StaticResource D.Segment}" Content="GLASS"
                                                     IsChecked="{Binding AutoColorMode, Converter={StaticResource Eq}, ConverterParameter=Glass}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Pad colors" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="default follows appearance (glass too)" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                              VerticalAlignment="Center" IsChecked="{Binding LockCreatedPads}" />
                                    <StackPanel>
                                        <TextBlock Text="Lock created pads" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="the next run then only sorts new desktop icons" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                              VerticalAlignment="Center" IsChecked="{Binding IncludeSystemIcons}" />
                                    <StackPanel>
                                        <TextBlock Text="Include system icons" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="recycle bin, your user folder, this pc...: a shortcut goes in a pad, the desktop icon is hidden" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                              VerticalAlignment="Center" IsChecked="{Binding IncludeAllUsersDesktop}" />
                                    <StackPanel>
                                        <TextBlock Text="Include all-users shortcuts" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="programs installed for everyone; asks for admin permission, and removes them for other accounts on this pc too" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource D.Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource D.Toggle}"
                                              VerticalAlignment="Center" IsChecked="{Binding AnimateAutoMode}" />
                                    <StackPanel>
                                        <TextBlock Text="Animate" Style="{StaticResource D.Label}" />
                                        <TextBlock Text="fade out, then reveal the new pads one by one" Style="{StaticResource D.Hint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </DockPanel>
    </Border>
</Window>

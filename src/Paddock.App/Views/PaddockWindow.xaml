<Window x:Class="Paddock.App.Views.PaddockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Paddock.App.Views"
        Title="padx"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        AllowDrop="True"
        UseLayoutRounding="True"
        MinWidth="140"
        MinHeight="32">

    <views:PaddockControl />
</Window>

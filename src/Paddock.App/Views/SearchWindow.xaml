<Window x:Class="Paddock.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="padx search"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Width="676"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="6,1" />
                            <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Margin="6,7" Background="{StaticResource D.Accent}" Visibility="Collapsed" />
                            <ContentPresenter Margin="18,0,16,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E00D1FF" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow, which falls mostly downwards -->
    <Border x:Name="Card"
            Margin="28,10,28,36"
            Background="{StaticResource D.Bg}"
            BorderBrush="{StaticResource D.LineStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="10" BlurRadius="30" Opacity="0.6" />
        </Border.Effect>

        <DockPanel x:Name="Layout" LastChildFill="True">

            <!-- Search box -->
            <Grid x:Name="Box" DockPanel.Dock="Top" Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                           Foreground="{StaticResource D.Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Search in desktop"
                           Foreground="{StaticResource D.TextFaint}" FontFamily="{StaticResource D.Sans}" FontSize="15"
                           VerticalAlignment="Center" Margin="3,0,0,0" IsHitTestVisible="False" />

                <TextBox x:Name="QueryBox" Grid.Column="1"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource D.Text}" CaretBrush="{StaticResource D.Accent}"
                         SelectionBrush="{StaticResource D.Accent}"
                         FontFamily="{StaticResource D.Sans}" FontSize="15"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         TextChanged="QueryBox_TextChanged" />

                <TextBlock x:Name="HotkeyHint" Grid.Column="2" Margin="10,0,16,0"
                           Foreground="{StaticResource D.TextFaint}" FontFamily="{StaticResource D.Mono}" FontSize="10"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Results, under the box (or above it, when the box sits at the bottom of the screen) -->
            <StackPanel x:Name="ResultsArea" Visibility="Collapsed">
                <Border x:Name="Divider" Height="1" Background="{StaticResource D.Line}" />

                <TextBlock x:Name="NoMatches" Text="nothing on the desktop matches" Visibility="Collapsed"
                           Foreground="{StaticResource D.TextFaint}" FontFamily="{StaticResource D.Mono}" FontSize="11"
                           Margin="20,12,0,4" />

                <ListBox x:Name="Results"
                         Background="Transparent" BorderThickness="0" Padding="0,5"
                         MaxHeight="360"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ResultItem}"
                         PreviewMouseLeftButtonUp="Results_PreviewMouseLeftButtonUp"
                         PreviewMouseRightButtonDown="Results_PreviewMouseRightButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Source="{Binding Icon.IconImage}" Width="22" Height="22"
                                       Visibility="{Binding ItemVisibility}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- The "Search Google" row -->
                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource D.Accent}" Visibility="{Binding WebVisibility}"
                                           Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource D.Text}"
                                           FontFamily="{StaticResource D.Sans}" FontSize="13.5"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" />

                                <TextBlock Grid.Column="2" Margin="10,1,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource D.Mono}" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource D.Accent}" />
                                    <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource D.TextFaint}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Run" FontWeight="SemiBold" InputGestureText="Enter" Click="Menu_Run" />
                            <MenuItem Header="Find place" InputGestureText="Ctrl+Enter" Click="Menu_FindPlace" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

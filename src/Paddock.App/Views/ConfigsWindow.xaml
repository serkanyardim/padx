<Window x:Class="Paddock.App.Views.ConfigsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="padx Configs"
        Width="620" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource D.Bg}"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ConfigItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2,0,0,0" Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource D.Raised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource D.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource D.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource D.Mono}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource D.TextFaint}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource D.LineStrong}" BorderThickness="1">
        <DockPanel>

            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Rectangle Width="8" Height="8" Fill="{StaticResource D.Accent}" Margin="0,0,10,0" />
                    <TextBlock Text="PADX" FontFamily="{StaticResource D.Mono}" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource D.Text}" />
                    <TextBlock Text="  // CONFIGS" FontFamily="{StaticResource D.Mono}" FontSize="12"
                               Foreground="{StaticResource D.TextDim}" />
                </StackPanel>
                <Button Style="{StaticResource D.ChromeButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,6,6,0" ToolTip="Close (Esc)"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.3"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <!-- Status line: brief feedback instead of dialogs -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource D.Line}" BorderThickness="0,1,0,0" Padding="22,9">
                <Grid>
                    <TextBlock x:Name="Status" FontFamily="{StaticResource D.Mono}" FontSize="11"
                               Foreground="{StaticResource D.Accent}" Opacity="0" />
                    <TextBlock Text="double-click to load · esc to close" Style="{StaticResource D.Hint}"
                               Margin="0" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="22,6,22,0">

                <!-- The screen right now, and its default -->
                <Border Background="{StaticResource D.Panel}" BorderBrush="{StaticResource D.Line}"
                        BorderThickness="1" Padding="12,9" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SCREEN " Style="{StaticResource ColumnHead}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="ScreenText" FontFamily="{StaticResource D.Mono}" FontSize="12"
                                   Foreground="{StaticResource D.Text}" VerticalAlignment="Center" />
                        <TextBlock Text="   DEFAULT " Style="{StaticResource ColumnHead}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="DefaultText" FontFamily="{StaticResource D.Mono}" FontSize="12"
                                   Foreground="{StaticResource D.Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Save as a new config -->
                <TextBlock Text="// SAVE CURRENT LAYOUT" Style="{StaticResource D.Section}" Margin="0,16,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource D.Button}" Content="SAVE"
                            Foreground="{StaticResource D.Accent}" Margin="8,0,0,0" Click="Save_Click" />
                    <TextBox x:Name="NameBox" Style="{StaticResource D.Field}" FontSize="12" Padding="2"
                             KeyDown="NameBox_KeyDown" />
                </DockPanel>
                <TextBlock x:Name="SaveHint" Style="{StaticResource D.Hint}" Margin="0,4,0,0" />

                <!-- List heading -->
                <TextBlock Text="// SAVED CONFIGS" Style="{StaticResource D.Section}" Margin="0,16,0,6" />
                <Grid Margin="14,0,14,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource ColumnHead}" />
                    <TextBlock Grid.Column="2" Text="RESOLUTION" Style="{StaticResource ColumnHead}" />
                    <TextBlock Grid.Column="3" Text="SAVED" Style="{StaticResource ColumnHead}" />
                </Grid>
            </StackPanel>

            <!-- Actions on the selected config -->
            <Border DockPanel.Dock="Bottom" Padding="22,10,22,12">
                <DockPanel>
                    <Button x:Name="LoadButton" DockPanel.Dock="Right" Style="{StaticResource D.Button}" Content="LOAD"
                            Foreground="{StaticResource D.Accent}" Click="Load_Click" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DefaultButton" Style="{StaticResource D.Button}" Content="★ SET DEFAULT"
                                Margin="0,0,8,0" Click="Default_Click" />
                        <Button x:Name="OverwriteButton" Style="{StaticResource D.Button}" Content="SAVE OVER"
                                Margin="0,0,8,0" Click="Overwrite_Click"
                                ToolTip="Replace the selected config with the current layout" />
                        <Button x:Name="DeleteButton" Style="{StaticResource D.Button}" Content="DELETE" Click="Delete_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="22,0,22,0">
                <ListBox x:Name="List" Background="{StaticResource D.Panel}" BorderBrush="{StaticResource D.Line}"
                         BorderThickness="1" ItemContainerStyle="{StaticResource ConfigItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="★" FontSize="12" Foreground="{StaticResource D.Accent}"
                                           VerticalAlignment="Center" Visibility="{Binding StarVisibility}"
                                           ToolTip="{Binding StarTip}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource D.Mono}" FontSize="12"
                                           Foreground="{StaticResource D.Text}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding ResolutionText}" FontFamily="{StaticResource D.Mono}"
                                           FontSize="11" Foreground="{Binding ResolutionBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding SavedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                           FontFamily="{StaticResource D.Mono}" FontSize="10"
                                           Foreground="{StaticResource D.TextFaint}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Style="{StaticResource D.Hint}"
                           Text="no configs yet — type a name above and press save" />
            </Grid>
        </DockPanel>
    </Border>
</Window>

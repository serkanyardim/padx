<Window x:Class="Paddock.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Paddock"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource D.Bg}"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="200" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Faint blueprint grid behind everything -->
        <DrawingBrush x:Key="Grid" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Opacity="0.35">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1E2A36" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="16,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,16" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource D.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource D.TextFaint}" />
            <Setter Property="Width" Value="110" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource D.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource D.Text}" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource D.LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource D.Mono}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource D.TextDim}" />
        </Style>

        <Storyboard x:Key="Blink" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Caret" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.1" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Blink}" />
        </EventTrigger>
    </Window.Triggers>

    <Border BorderBrush="{StaticResource D.LineStrong}" BorderThickness="1">
        <Grid>
            <Rectangle Fill="{StaticResource Grid}" />

            <!-- Accent hairline across the top -->
            <Rectangle Height="2" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0000D1FF" Offset="0" />
                        <GradientStop Color="#FF00D1FF" Offset="0.5" />
                        <GradientStop Color="#0000D1FF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Button Style="{StaticResource D.ChromeButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,8,0" ToolTip="Close (Esc)" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.3"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>

            <StackPanel Margin="34,34,34,26">

                <!-- Logo + name -->
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="56" Height="56" Margin="0,0,18,0">
                        <Canvas.Effect>
                            <DropShadowEffect Color="#00D1FF" BlurRadius="18" ShadowDepth="0" Opacity="0.75" />
                        </Canvas.Effect>
                        <Rectangle Width="56" Height="56" RadiusX="11" RadiusY="11"
                                   Stroke="{StaticResource D.Accent}" StrokeThickness="2" Fill="#1400D1FF" />
                        <Line X1="17" Y1="15" X2="17" Y2="41" Stroke="{StaticResource D.Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="28" Y1="15" X2="28" Y2="41" Stroke="{StaticResource D.Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="39" Y1="15" X2="39" Y2="41" Stroke="{StaticResource D.Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="11" Y1="23" X2="45" Y2="23" Stroke="#B300D1FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="11" Y1="33" X2="45" Y2="33" Stroke="#B300D1FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PADDOCK" FontFamily="{StaticResource D.Mono}" FontSize="30"
                                   FontWeight="Bold" Foreground="{StaticResource D.Text}" />
                        <StackPanel Orientation="Horizontal" Margin="1,2,0,0">
                            <TextBlock x:Name="VersionText" FontFamily="{StaticResource D.Mono}" FontSize="11"
                                       Foreground="{StaticResource D.Accent}" />
                            <TextBlock Text="  //  desktop, organized." FontFamily="{StaticResource D.Mono}" FontSize="11"
                                       Foreground="{StaticResource D.TextDim}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- System readout -->
                <Border Margin="0,26,0,0" Padding="14,12" Background="#B20B0E13"
                        BorderBrush="{StaticResource D.Line}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="&gt; developer" Style="{StaticResource Key}" />
                            <TextBlock Text="axzelx" Style="{StaticResource Val}" Foreground="{StaticResource D.Accent}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="&gt; based on" Style="{StaticResource Key}" />
                            <TextBlock Style="{StaticResource Val}">
                                <Hyperlink NavigateUri="https://github.com/HappyDane/Paddock" RequestNavigate="Link_RequestNavigate"
                                           Foreground="{StaticResource D.Text}" TextDecorations="{x:Null}">
                                    <Run Text="github.com/HappyDane/Paddock" />
                                </Hyperlink>
                                <Run Text="  (MIT)" Foreground="{StaticResource D.TextFaint}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="&gt; build" Style="{StaticResource Key}" />
                            <TextBlock x:Name="BuildText" Style="{StaticResource Val}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="&gt; runtime" Style="{StaticResource Key}" />
                            <TextBlock x:Name="RuntimeText" Style="{StaticResource Val}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&gt; status" Style="{StaticResource Key}" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource Val}" />
                            <Rectangle x:Name="Caret" Width="7" Height="13" Fill="{StaticResource D.Accent}"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- What it does -->
                <TextBlock Text="// FEATURES" Style="{StaticResource D.Section}" Margin="0,20,0,8" />
                <WrapPanel>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="PADS" Style="{StaticResource ChipText}" /></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="GLASS" Style="{StaticResource ChipText}" /></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="AUTO ORGANIZE" Style="{StaticResource ChipText}" /></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="SMART CATEGORIES" Style="{StaticResource ChipText}" /></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="CONFIGS" Style="{StaticResource ChipText}" /></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="CTRL + DRAG" Style="{StaticResource ChipText}" /></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="GLOBAL HOTKEYS" Style="{StaticResource ChipText}" /></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="WIN+D PROOF" Style="{StaticResource ChipText}" /></Border>
                </WrapPanel>

                <TextBlock Margin="0,18,0,0" FontFamily="{StaticResource D.Mono}" FontSize="9.5"
                           Foreground="{StaticResource D.TextFaint}" TextWrapping="Wrap"
                           Text="derived from the open-source Paddock project by HappyDane, released under the MIT license." />
            </StackPanel>
        </Grid>
    </Border>
</Window>

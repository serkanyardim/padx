<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Paddock.App</RootNamespace>
    <AssemblyName>padx</AssemblyName>
    <ApplicationIcon>..\..\assets\padx.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Single-file publish settings (activated via publish profile or CLI) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- WinForms assembly for NotifyIcon (tray icon) without implicit usings -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paddock.Core\Paddock.Core.csproj" />
    <ProjectReference Include="..\Paddock.Shell\Paddock.Shell.csproj" />
  </ItemGroup>

</Project>
